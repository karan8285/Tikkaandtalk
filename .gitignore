# ─── Dependencies ─────────────────────────────────────────────────
# 543 MB / ~80k files, and it holds platform-specific native binaries
# (@esbuild/win32-x64, @tailwindcss/oxide-win32-x64-msvc). Committing those
# from a Windows machine breaks the Vercel Linux build.
node_modules/

# ─── Build output ─────────────────────────────────────────────────
# Vercel builds this itself from source on every deploy.
dist/
dist-ssr/
*.local

# ─── Environment / secrets ────────────────────────────────────────
# The Supabase anon key in utils/supabase/info.tsx is public by design and
# stays tracked. Real secrets (JWT_SECRET, ADMIN_PIN, MIDTRANS_SERVER_KEY)
# belong in Supabase Edge Function secrets and Vercel env vars — never here.
.env
.env.*
!.env.example
*.pem

# ─── Vite / tooling caches ────────────────────────────────────────
.vite/
node_modules/.vite/
*.tsbuildinfo
.eslintcache

# ─── Capacitor / Android build artifacts ──────────────────────────
# android/app/src/** is real source and stays tracked. Everything below is
# generated by Gradle or `npx cap sync`.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/capacitor.build.gradle
android/capacitor.settings.gradle
*.keystore
!debug.keystore
.capacitor/

# ─── Supabase local dev ───────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ─── Editor / IDE ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Claude Code: keep shared config, ignore machine-local overrides.
.claude/settings.local.json

# ─── OS cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
